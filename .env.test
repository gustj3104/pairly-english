# Loaded automatically by Vitest (mode "test") on top of .env. Committed —
# contains no secrets — so the test suite is hermetic and never depends on a
# running backend or real network access. Auth calls in unit tests are
# mocked per-test (vi.mock('../services/api/authService')), not via an env
# flag — there is no VITE_USE_MOCK_AUTH.
VITE_USE_MOCK_AI=true

# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.

NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# PostgreSQL connection string. No default — must be provided locally.
DATABASE_URL=postgres://user:password@localhost:5432/pairly_english

# Origin allowed to call this API in development (single origin, no wildcard).
FRONTEND_ORIGIN=http://localhost:5173

# Mindlogic (factchat-cloud) gateway credentials. No default — must be provided locally.
MINDLOGIC_API_KEY=
MINDLOGIC_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
MINDLOGIC_MODEL=claude-haiku-4-5-20251001
MINDLOGIC_MONTHLY_CREDIT_LIMIT=5000

# Temporary pre-auth gate for AI routes (e.g. POST /api/v1/reflections/compare)
# until real authentication exists. Required to call them outside production;
# production always refuses them regardless of this value. Generate a random
# string yourself — never reuse a real secret, never bundle into the frontend.
AI_DEV_ACCESS_TOKEN=

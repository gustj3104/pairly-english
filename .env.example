# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.
#
# Every var here is VITE_-prefixed and therefore bundled into the browser
# build — never put a secret (Mindlogic API key, backend dev-auth token,
# etc.) in a VITE_* var. Those live only in the backend repo's own
# .env.local.

# Base URL of the pairly-english-server backend this app talks to.
# Not a secret — safe to ship in the client bundle.
VITE_API_BASE_URL=http://localhost:3001

# When exactly 'true', AI features use mockAIService instead of calling the
# real backend. Any other value (including unset) calls the real backend —
# there is no automatic fallback to mock data on a failed API call.
VITE_USE_MOCK_AI=false

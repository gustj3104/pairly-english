# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.
#
# Every var here is VITE_-prefixed and therefore bundled into the browser
# build — never put a secret (Mindlogic API key, the backend's shared
# password/session secret, the CLI dev-auth token, etc.) in a VITE_* var.
# Those live only in the backend repo's own .env.local. Note there is no
# VITE_API_BASE_URL: the API client always calls relative `/api/...` paths,
# proxied to the backend by Vite in dev (see vite.config.ts) and by the
# deployment's own rewrite in production (see README).

# When exactly 'true', AI features use mockAIService instead of calling the
# real backend. Any other value (including unset) calls the real backend —
# there is no automatic fallback to mock data on a failed API call. Auth
# (login/session/logout) always calls the real backend; there is no mock
# mode for it.
VITE_USE_MOCK_AI=false

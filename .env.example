# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.

NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# PostgreSQL connection string. No default — must be provided locally.
DATABASE_URL=postgres://user:password@localhost:5432/pairly_english

# Origin allowed to call this API in development (single origin, no wildcard).
FRONTEND_ORIGIN=http://localhost:5173

# Mindlogic (factchat-cloud) gateway credentials. No default — must be provided locally.
MINDLOGIC_API_KEY=
MINDLOGIC_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
MINDLOGIC_MODEL=claude-haiku-4-5-20251001
MINDLOGIC_MONTHLY_CREDIT_LIMIT=5000

# Shared password both users log in with via POST /api/v1/auth/login (no
# per-user accounts, no email, no invite codes). Required — the server
# won't boot without it. Min 8 characters (enforced in src/config/env.ts).
# Never put this in the frontend's env in any form.
APP_SHARED_PASSWORD=

# HMAC signing key for session JWTs (src/services/auth/session.ts). Required
# — the server won't boot without it. Min 32 characters. Generate a random
# string yourself; never reuse a real secret, never bundle into the frontend.
SESSION_SECRET=

# Session cookie / JWT lifetime, in seconds. Default: 30 days.
SESSION_MAX_AGE_SECONDS=2592000

# Static bearer token for the CLI smoke script (scripts/mindlogic-smoke-test*.ts)
# only — real browser sessions authenticate via POST /api/v1/auth/login instead
# (see src/plugins/auth-gate.ts). Optional; never accepted in production
# regardless of this value. Generate a random string yourself — never reuse a
# real secret, never bundle into the frontend.
AI_DEV_ACCESS_TOKEN=

# Overrides how many times a 429/5xx Mindlogic response is retried (after
# the first attempt) before giving up. Unset = standard policy (2 retries,
# 3 attempts total). Set to 0 for a controlled one-shot call — e.g. a real
# smoke test — where a second provider POST must be impossible regardless
# of the response. Never affects timeout/connection-reset/incomplete-response,
# which are never retried no matter what this is set to. Default production
# policy is undecided; leave unset unless you have a specific reason.
MINDLOGIC_MAX_RETRIES=0
